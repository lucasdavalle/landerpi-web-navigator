<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landerpi_web_nav</name>
  <version>0.1.0</version>
  <description>
    Live lidar SLAM + Nav2 navigation for LanderPi driven from a web UI:
    C++ REST/WebSocket gateway, velocity safety gate and map vectorization
    (walls as line segments).
  </description>
  <maintainer email="lucasdavalle25@gmail.com">ldavalle</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>libopencv-dev</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>libssl-dev</depend>

  <!-- Stock Hiwonder packages used at runtime only (landerpi_description,
       rf2o_laser_odometry, imu_calib, calibration) are deliberately not
       declared: they are not in rosdep and CI runs on a clean ros:humble. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>imu_complementary_filter</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
