"""
Set the A7 web gateway password.

Writes ~/.a7/password (mode 600) as pbkdf2-sha256$iterations$salt$hash, the
format AuthManager reads. The password itself is never stored. Run it as
the same user that runs the gateway (root inside the MentorPi container).
"""

import getpass
import hashlib
import os
import secrets
import sys

ITERATIONS = 200000


def main():
    path = os.path.expanduser(sys.argv[1] if len(sys.argv) > 1 else '~/.a7/password')
    pw = getpass.getpass('Nueva contraseña: ')
    if len(pw) < 8:
        print('Mínimo 8 caracteres.')
        return 1
    if getpass.getpass('Repetila: ') != pw:
        print('No coinciden.')
        return 1
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac('sha256', pw.encode(), salt, ITERATIONS, 32)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(f'pbkdf2-sha256${ITERATIONS}${salt.hex()}${digest.hex()}\n')
    print(f'Guardada en {path}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
